rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // Private User Profile - strictly isolated by authenticated UID
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Private User Subcollections
      match /medications/{medicationId} {
        allow read, write: if isOwner(userId);
      }

      match /appointments/{appointmentId} {
        allow read, write: if isOwner(userId);
      }

      match /medicationHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }

      match /wellness/{wellnessId} {
        allow read, write: if isOwner(userId);
      }

      match /careCircle/{memberId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Catch-all for any additional user-specific subcollections
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
